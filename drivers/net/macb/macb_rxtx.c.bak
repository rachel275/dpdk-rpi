// SPDX-License-Identifier: BSD-3-Clause
// DPDK MACB/GEM RX/TX path with non-coherent cache sync and TX_USED-in-addr logic

#include <stdio.h>
#include <string.h>
#include <inttypes.h>

#include <rte_io.h>
#include <rte_log.h>
#include <rte_mbuf.h>
#include <rte_memzone.h>
#include <rte_malloc.h>
#include <rte_hexdump.h>
#include <ethdev_driver.h>

#include "macb_hw.h"
#include "dma_sync_user.h"

/* Flip to 1 for occasional 64B hexdumps of payloads */
#define MACB_DBG_HEXDUMP 0

/* Some MACB/GEM variants need a doorbell to start TX */
#ifndef NCR_TSTART
#define NCR_TSTART (1u << 9)
#endif

/* Provided by macb_ethdev.c (opened during dev_start) */
extern int macb_dma_sync_fd;

/* Get data buffer IOVA for mbuf payload */
static inline rte_iova_t
mbuf_data_iova(const struct rte_mbuf *m)
{
    return rte_pktmbuf_iova(m);
}

/* -------------------------------------------------------------------------- */
/* RX                                                                         */
/* -------------------------------------------------------------------------- */

static inline int
macb_rx_refill_one(struct macb_rxq *rxq, uint16_t idx)
{
    struct rte_mbuf *m = rte_pktmbuf_alloc(rxq->mp);
    if (unlikely(!m)) {
        RTE_LOG(ERR, EAL, "macb: RX ref/alloc failed at idx=%u\n", idx);
        return -1;
    }

    rxq->sw_ring[idx] = m;

    const uint32_t wrap = (idx == (rxq->nb_desc - 1)) ? RX_WRAP : 0;
    const rte_iova_t iova = mbuf_data_iova(m);
    const uint32_t addr = ((uint32_t)iova & RX_ADDR_MASK) | wrap;

    /* Give ownership to HW: clear USED by writing a fresh addr, ctrl=0 */
    rxq->ring[idx].addr = addr;
    rxq->ring[idx].ctrl = 0;

    /* For non-coherent systems: clean the descriptor to RAM */
    if (macb_dma_sync_fd >= 0)
        dma_sync_to_dev(macb_dma_sync_fd, &rxq->ring[idx], sizeof(struct macb_desc));

    /* Ensure HW sees descriptor updates before it DMAs */
    rte_io_wmb();

    RTE_LOG(INFO, EAL,
        "macb: RX desc[%u] prepared: addr=0x%08x (iova=0x%08" PRIx64 ") wrap=%u\n",
        idx, rxq->ring[idx].addr, (uint64_t)iova, !!wrap);

    return 0;
}

/* MUST be non-static: referenced from macb_ethdev.c */
void
macb_rx_init(struct macb_rxq *rxq)
{
    for (uint16_t i = 0; i < rxq->nb_desc; i++)
        (void)macb_rx_refill_one(rxq, i);

    rxq->cons = 0;

    /* Publish the whole ring */
    rte_wmb();

    RTE_LOG(INFO, EAL, "macb: RX ring initialized (%u desc)\n", rxq->nb_desc);
}

uint16_t
macb_rx_burst(void *queue, struct rte_mbuf **rx_pkts, uint16_t nb_pkts)
{
    struct macb_rxq *rxq = (struct macb_rxq *)queue;
    uint16_t nb = 0;
    static uint32_t dbg_rx_cnt;

    while (nb < nb_pkts) {
        const uint16_t i = rxq->cons;
        struct macb_desc *d = &rxq->ring[i];

        /* Pull descriptor from device before reading USED/len */
        if (macb_dma_sync_fd >= 0)
            dma_sync_from_dev(macb_dma_sync_fd, d, sizeof(*d));

        /* Completed when HW sets USED in addr */
        const uint32_t addr = d->addr;
        if (!(addr & RX_USED)) {
            /* no completed RX desc */
            break;
        }

        /* Order HW writes (addr/ctrl) before we read ctrl/len */
        rte_io_rmb();

        struct rte_mbuf *m = rxq->sw_ring[i];
        const uint16_t len = (uint16_t)(d->ctrl & RX_LEN_MASK);

        if (unlikely((dbg_rx_cnt++ & 0x1F) == 0)) {
            RTE_LOG(INFO, EAL,
                "macb: RX ready idx=%u addr=0x%08x ctrl=0x%08x len=%u mbuf=%p\n",
                i, d->addr, d->ctrl, len, m);
        }

        /* Invalidate payload (device->CPU) for non-coherent systems */
        if (macb_dma_sync_fd >= 0) {
            void *base = m->buf_addr;
            size_t inv_len = RTE_PKTMBUF_HEADROOM + len;
            dma_sync_from_dev(macb_dma_sync_fd, base, inv_len);
            RTE_LOG(INFO, EAL,
                "macb: RX cache-sync FROM_DEV idx=%u len=%u base=%p\n",
                i, len, base);
        }

        m->data_off = RTE_PKTMBUF_HEADROOM;
        m->pkt_len  = len;
        m->data_len = len;

#if MACB_DBG_HEXDUMP
        if (unlikely((dbg_rx_cnt & 0x3F) == 1)) {
            rte_hexdump(stdout, "macb RX pkt",
                        rte_pktmbuf_mtod(m, void *),
                        RTE_MIN((uint32_t)64, (uint32_t)len));
        }
#endif

        RTE_LOG(INFO, EAL,
            "macb: RX done[%u]: addr=0x%08x ctrl=0x%08x len=%u -> app\n",
            i, d->addr, d->ctrl, len);

        rx_pkts[nb++] = m;

        /* Refill this slot with a fresh buffer (gives ownership back to HW) */
        if (unlikely(macb_rx_refill_one(rxq, i) < 0)) {
            rxq->sw_ring[i] = NULL;
            RTE_LOG(ERR, EAL,
                "macb: RX refill failed at idx=%u; leaving USED set\n", i);
        }

        uint16_t next = (uint16_t)(i + 1);
        rxq->cons = (next == rxq->nb_desc) ? 0 : next;
    }

    if (nb || unlikely((dbg_rx_cnt & 0x7F) == 0)) {
        RTE_LOG(INFO, EAL, "macb: rx_burst returns %u packets\n", nb);
    }
    return nb;
}

/* -------------------------------------------------------------------------- */
/* TX                                                                         */
/* -------------------------------------------------------------------------- */

uint16_t
macb_tx_burst(void *queue, struct rte_mbuf **tx_pkts, uint16_t nb_pkts)
{
    struct macb_txq *txq = (struct macb_txq *)queue;
    uint16_t sent = 0;
    static uint32_t dbg_tx_cnt;

    /* Reclaim completed descriptors (FREE when HW sets USED in ADDR) */
    while (txq->cons != txq->prod) {
        const uint16_t i = txq->cons;
        struct macb_desc *d = &txq->ring[i];

        /* Pull current descriptor state from RAM if non-coherent */
        if (macb_dma_sync_fd >= 0)
            dma_sync_from_dev(macb_dma_sync_fd, d, sizeof(*d));

        if (!(d->addr & TX_USED))  /* HW still owns it (USED==0) */
            break;

        struct rte_mbuf *om = txq->sw_ring[i];
        RTE_LOG(INFO, EAL,
            "macb: TX reclaim idx=%u ctrl=0x%08x addr=0x%08x mbuf=%p\n",
            i, d->ctrl, d->addr, om);

        if (om)
            rte_pktmbuf_free(om);
        txq->sw_ring[i] = NULL;

        uint16_t next = (uint16_t)(i + 1);
        txq->cons = (next == txq->nb_desc) ? 0 : next;
    }

    /* Produce new descriptors (slot is FREE when addr has USED=1) */
    while (sent < nb_pkts) {
        const uint16_t i = txq->prod;
        struct macb_desc *d = &txq->ring[i];

        /* Pull current d if non-coherent before testing availability */
        if (macb_dma_sync_fd >= 0)
            dma_sync_from_dev(macb_dma_sync_fd, d, sizeof(*d));

        if (!(d->addr & TX_USED)) {
            RTE_LOG(INFO, EAL,
                "macb: TX slot[%u] not free, stop (ctrl=0x%08x addr=0x%08x)\n",
                i, d->ctrl, d->addr);
            break;
        }

        struct rte_mbuf *m = tx_pkts[sent];
        const uint32_t len  = rte_pktmbuf_pkt_len(m);
        const uint32_t wrap = (i == (txq->nb_desc - 1)) ? TX_WRAP : 0;

#if MACB_DBG_HEXDUMP
        if (unlikely((dbg_tx_cnt & 0x3F) == 0)) {
            rte_hexdump(stdout, "macb TX pkt",
                        rte_pktmbuf_mtod(m, void *),
                        RTE_MIN(len, (uint32_t)64));
        }
#endif

        /* Clean payload to RAM for non-coherent systems */
        if (macb_dma_sync_fd >= 0) {
            dma_sync_to_dev(macb_dma_sync_fd, rte_pktmbuf_mtod(m, const void *), len);
            RTE_LOG(INFO, EAL,
                "macb: TX cache-sync TO_DEV idx=%u len=%u data=%p\n",
                i, len, rte_pktmbuf_mtod(m, void *));
        }

        /* Program buffer address first */
        d->addr = (uint32_t)mbuf_data_iova(m);

        /* Ensure addr is visible before ctrl */
        rte_io_wmb();

        /* Hand ownership to HW by CLEARING USED in addr */
        d->addr &= ~TX_USED;

        /* Set len/LAST/(WRAP if last) */
        d->ctrl = (len & TX_LEN_MASK) | TX_LAST | wrap;

        /* Clean the descriptor itself to RAM if non-coherent */
        if (macb_dma_sync_fd >= 0)
            dma_sync_to_dev(macb_dma_sync_fd, d, sizeof(*d));

        RTE_LOG(INFO, EAL,
            "macb: TX prod idx=%u addr=0x%08x ctrl=0x%08x len=%u mbuf=%p\n",
            i, d->addr, d->ctrl, len, m);

        txq->sw_ring[i] = m;

        uint16_t next = (uint16_t)(i + 1);
        txq->prod = (next == txq->nb_desc) ? 0 : next;
        sent++;
        dbg_tx_cnt++;
    }

    if (sent || unlikely((dbg_tx_cnt & 0x7F) == 0)) {
        RTE_LOG(INFO, EAL, "macb: tx_burst sent %u packets\n", sent);
    }

    /* Doorbell TX if we produced anything */
    if (sent > 0 && txq->ad) {
        macb_writel(&txq->ad->hw, MACB_NCR,
                    macb_readl(&txq->ad->hw, MACB_NCR) | NCR_TSTART);
        RTE_LOG(INFO, EAL, "macb: TX kick (TSTART)\n");
    }

    return sent;
}

